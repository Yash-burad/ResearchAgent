# LLM Configuration
# Options: ollama, gemini, openai
LLM_PROVIDER=ollama
DEFAULT_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# API Keys (Optional - only if switching from Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application Configuration
MAX_TOPICS_DISCOVERED=20
MAX_TOPICS_SELECTED=5
MAX_SOURCES_PER_TOPIC=5
